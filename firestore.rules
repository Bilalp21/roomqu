rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // --- DEVELOPMENT RULES (PERMISSIVE) ---
    // Ubah aturan ini sebelum Production!
    
    // Hotels: Semua orang bisa baca, User login bisa buat/edit/hapus
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Rooms: Sama seperti hotels
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Vendors: Ditambahkan untuk modul Vendor
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Promos
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Bookings
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Users
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

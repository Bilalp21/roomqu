rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.matches('admin.*');
    }
    
    function isPartner() {
      return isAuthenticated() && request.auth.token.email.matches('partner.*');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Settings - Semua bisa baca, hanya admin bisa tulis
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users - User bisa akses data sendiri, admin & partner bisa baca semua
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isPartner();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
    }
    
    // Hotels - Semua bisa baca, partner bisa kelola hotel mereka, admin bisa kelola semua
    match /hotels/{hotelId} {
      allow read: if true;
      allow create: if isPartner() || isAdmin();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // Rooms - Semua bisa baca, partner bisa kelola room hotel mereka, admin bisa kelola semua
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isPartner() || isAdmin();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // Promos - Semua bisa baca, partner bisa kelola promo mereka, admin bisa kelola semua
    match /promos/{promoId} {
      allow read: if true;
      allow create: if isPartner() || isAdmin();
      allow update, delete: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
    }
    
    // Bookings - User bisa akses booking mereka, partner bisa akses booking hotel mereka, admin bisa akses semua
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isPartner() && resource.data.partnerId == request.auth.uid);
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }
    
    // Reviews - Semua bisa baca, user bisa buat review, owner bisa edit/delete review mereka
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
